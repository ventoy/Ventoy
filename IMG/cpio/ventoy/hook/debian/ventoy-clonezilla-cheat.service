[Unit]
Description=Ventoy CloneZilla Device Cheat
After=systemd-udevd.service

[Service]
Type=oneshot
ExecStart=mv /dev/VTISOPART /dev/bk_VTISOPART
ExecStart=cp -a /dev/DMXXX  /dev/VTISOPART
ExecStartPost=-/bin/sh -c '\
    rm -f /etc/systemd/system/ventoy-clonezilla-cheat.service;\
    rm -f /etc/systemd/system-preset/90-ventoy-clonezilla.preset;\
    rm -f /etc/systemd/system/sysinit.target.wants/ventoy-clonezilla-cheat.service;\
'

WantedBy=sysinit.target
